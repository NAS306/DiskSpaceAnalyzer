<Window x:Class="DiskSpaceAnalyzer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:DiskSpaceAnalyzer.Controls" xmlns:controls="clr-namespace:DiskSpaceAnalyzer.Controls"
        Title="{loc:Tr Text.F4C1B0B8EDFE}" Width="1440" Height="920" MinWidth="1000" MinHeight="600" Background="#0D1620" FontFamily="Segoe UI, Malgun Gothic" FontSize="12" WindowStartupLocation="Manual">
  <Window.Resources>
    <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="6,2"/><Setter Property="FontSize" Value="11"/></Style>
    <Style x:Key="DepthButton" TargetType="RadioButton" BasedOn="{StaticResource HelpBehaviour}">
      <Setter Property="Foreground" Value="#91ACBA"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,1,0"/><Setter Property="FontSize" Value="11"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="DepthBorder" Background="#1B2B39" Padding="6,1"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="DepthBorder" Property="Background" Value="#28544F"/><Setter Property="Foreground" Value="#9CF3DB"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="30"/><RowDefinition Height="22"/><RowDefinition Height="*"/><RowDefinition Height="20"/><RowDefinition Height="20"/></Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#111E2A" BorderBrush="#293744" BorderThickness="0,0,0,1" Padding="4,0">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
          <TextBlock Text="DiskSpace" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="LanguageButton" Content="KO ▾" Style="{StaticResource CompactButton}" Click="LanguageClicked" Margin="0,0,4,0" ToolTip="{loc:Tr Language.Tooltip}"/>
          <Button Content="{loc:Tr Text.1940C5C85045}" Style="{StaticResource CompactButton}" Click="ExplorerMenuClicked" ToolTip="{loc:Tr Help.ExplorerMenu}"/>
          <Button x:Name="FullScreenButton" Content="{loc:Tr Text.451354ACB402}" Style="{StaticResource CompactButton}" Click="FullScreenClicked" Margin="4,0,8,0" ToolTip="{loc:Tr Help.FullScreen}"/>
          <CheckBox x:Name="LiveToggle" Content="{loc:Tr Text.04909CAEEE96}" Foreground="#C7D4E1" VerticalAlignment="Center" IsChecked="True" Checked="LiveChanged" Unchecked="LiveChanged" Margin="0,0,12,0" FontSize="11" ToolTip="{loc:Tr Help.LiveUpdates}"/>
          <Button Content="{loc:Tr Text.486E6B2AFCB5}" Style="{StaticResource CompactButton}" Click="RefreshClicked" ToolTip="{loc:Tr Help.Refresh}"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="{loc:Tr Text.96C042462A24}" Style="{StaticResource CompactButton}" Click="ChooseFolderClicked" Margin="7,0,0,0" ToolTip="{loc:Tr Help.ChooseFolder}"/></StackPanel>
        <Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ScrollViewer MaxWidth="180" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="DrivePanel" Orientation="Horizontal"/></ScrollViewer>
          <Grid Grid.Column="1" Margin="5,0,3,0"><TextBox x:Name="EverythingSearchBox" Padding="5,2" FontSize="11" VerticalContentAlignment="Center" PreviewKeyDown="EverythingSearchKeyDown" ToolTip="{loc:Tr Help.SearchQuery}"/><TextBlock Text="{loc:Tr Text.C3C269815C58}" FontSize="10" Foreground="#698498" Margin="6,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=EverythingSearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
          <Button Grid.Column="2" Content="{loc:Tr Text.FD5B83F7DA1D}" Style="{StaticResource CompactButton}" Click="AdvancedSearchClicked" Margin="0,0,3,0" ToolTip="{loc:Tr Help.AdvancedSearch}"/>
          <Button Grid.Column="3" Content="{loc:Tr Text.63230CB6D066}" Style="{StaticResource CompactButton}" Click="SearchClicked" ToolTip="{loc:Tr Help.RunSearch}"/>
        </Grid>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" Margin="2,1,2,1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="184"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Margin="0,0,6,0"><Button x:Name="BackButton" Content="←" Style="{StaticResource CompactButton}" Click="BackClicked" Margin="0,0,4,0" IsEnabled="False" ToolTip="{loc:Tr Help.Back}"/><Button x:Name="UpButton" Content="{loc:Tr Text.421019B9DE5B}" Style="{StaticResource CompactButton}" Click="UpClicked" IsEnabled="False" ToolTip="{loc:Tr Help.Up}"/></StackPanel>
      <Border Grid.Column="1" Background="#152330" Padding="5,2" Margin="0,0,7,0"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="Breadcrumbs" Orientation="Horizontal" VerticalAlignment="Center"/></ScrollViewer></Border>
      <Grid Grid.Column="2" Margin="0,0,7,0"><TextBox x:Name="FilterBox" Padding="8,3" ToolTip="{loc:Tr Help.NameFilter}" TextChanged="FilterChanged" VerticalContentAlignment="Center" FontSize="11"/><TextBlock Text="{loc:Tr Text.01679AC08B7A}" Margin="9,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="#698498" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
      <StackPanel Grid.Column="3" Orientation="Horizontal">
        <Button x:Name="DetailsToggleButton" Content="{loc:Tr Text.856901810098}" Style="{StaticResource CompactButton}" Click="ToggleDetailsClicked" ToolTip="{loc:Tr Help.Details}"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2" Margin="4,0,4,1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="SizeLabel" Text="{loc:Tr Text.E6AC1362406C}" Foreground="#8197AB" FontSize="10" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock x:Name="SizeStat" Text="—" FontSize="15" Foreground="#70E0C6" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="{loc:Tr Help.Size}"/>
        <TextBlock Text="│" Foreground="#344A5B" Margin="12,0" VerticalAlignment="Center"/>
        <TextBlock Text="{loc:Tr Text.F7678038200A}" Foreground="#8197AB" FontSize="10" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock x:Name="CountStat" Text="—" FontSize="12" VerticalAlignment="Center" ToolTip="{loc:Tr Help.Counts}"/>
        <TextBlock Text="│" Foreground="#344A5B" Margin="12,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="TimeStat" Text="{loc:Tr Text.0FC20F412D6F}" Foreground="#9BB0C1" FontSize="11" VerticalAlignment="Center" ToolTip="{loc:Tr Help.ScanTime}"/>
        <TextBlock Text="ⓘ" Foreground="#698498" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock.ToolTip><TextBlock x:Name="Subtitle" Text="{loc:Tr Text.1E434C65949E}" MaxWidth="400" TextWrapping="Wrap"/></TextBlock.ToolTip></TextBlock>
      </StackPanel>
      <TextBlock x:Name="ScopeLabel" Grid.Column="1" Text="{loc:Tr Text.CFD03C8D5A4E}" FontSize="10" Foreground="#738C9F" TextTrimming="CharacterEllipsis" Margin="18,0" VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <CheckBox x:Name="FreeSpaceToggle" Content="{loc:Tr Space.ShowFree}" FontSize="10" Foreground="#C7D4E1" VerticalAlignment="Center" Margin="0,0,10,0" IsEnabled="False" IsChecked="True" Checked="FreeSpaceChanged" Unchecked="FreeSpaceChanged" ToolTip="{loc:Tr Space.Help}" ToolTipService.ShowOnDisabled="True"/>
        <CheckBox x:Name="ExcludeWindowsToggle" Content="{loc:Tr Text.8CF5B1E8EEC8}" FontSize="10" Foreground="#C7D4E1" VerticalAlignment="Center" Margin="0,0,12,0" Checked="ExclusionChanged" Unchecked="ExclusionChanged" ToolTip="{loc:Tr Help.ExcludeWindows}"/>
        <TextBlock Text="{loc:Tr Text.DCB06BEB51A4}" FontSize="10" Foreground="#8197AB" VerticalAlignment="Center" Margin="0,0,6,0"/><RadioButton Content="{loc:Tr Text.0A38B361DCA3}" Tag="0" Style="{StaticResource DepthButton}" Checked="DepthChanged" GroupName="Depth" ToolTip="{loc:Tr Help.DepthOne}"/><RadioButton Content="{loc:Tr Text.F8DC5EFC85ED}" Tag="1" Style="{StaticResource DepthButton}" Checked="DepthChanged" GroupName="Depth" IsChecked="True" ToolTip="{loc:Tr Help.DepthTwo}"/><RadioButton Content="{loc:Tr Text.01CF320EC336}" Tag="2" Style="{StaticResource DepthButton}" Checked="DepthChanged" GroupName="Depth" ToolTip="{loc:Tr Help.DepthThree}"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="SplitterColumn" Width="0"/><ColumnDefinition x:Name="DetailsColumn" Width="0"/></Grid.ColumnDefinitions>
      <Border Background="#0D1721" ClipToBounds="True">
        <Grid>
          <controls:TreemapView x:Name="Treemap"/>
          <Border x:Name="EmptyOverlay" Background="#0D1721" Padding="25">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"><TextBlock Text="▥" FontSize="48" Foreground="#345867" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyTitle" Text="{loc:Tr Text.2450C5A2C04C}" FontSize="20" TextAlignment="Center" Margin="0,15,0,10" TextWrapping="Wrap"/><TextBlock x:Name="EmptyDescription" Text="{loc:Tr Text.2F2E98E8AE93}" Foreground="#8CA2B6" TextAlignment="Center" TextWrapping="Wrap" LineHeight="22"/></StackPanel>
          </Border>
        </Grid>
      </Border>
      <GridSplitter x:Name="PaneSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Center" Background="Transparent" Visibility="Collapsed" ToolTip="{loc:Tr Help.ListResize}"/>
      <Border x:Name="DetailsPane" Grid.Column="2" BorderBrush="#293E4C" BorderThickness="1" Background="#121F2C" ClipToBounds="True" Visibility="Collapsed">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="10,9" BorderBrush="#293E4C" BorderThickness="0,0,0,1"><DockPanel><TextBlock x:Name="DetailsHeading" Text="{loc:Tr Text.CE7E399B90FA}" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="ItemCount" Text="{loc:Tr Text.694F17379CF9}" Foreground="#89A3B6" HorizontalAlignment="Right" FontSize="10"/></DockPanel></Border>
          <Border DockPanel.Dock="Bottom" Padding="10,9" Background="#172836"><StackPanel><TextBlock x:Name="DetailName" Text="{loc:Tr Text.2A1C5D714908}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="11"/><TextBlock x:Name="DetailPath" Text="{loc:Tr Text.8CEB2CCE7CEB}" TextWrapping="Wrap" Foreground="#8CA2B6" FontSize="10" Margin="0,5,0,0" MaxHeight="45"/></StackPanel></Border>
          <ListView x:Name="EntryList" Background="Transparent" BorderThickness="0" SelectionChanged="EntrySelected" PreviewMouseLeftButtonUp="EntryListClicked" FontSize="11" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ToolTip="{loc:Tr Help.Details}">
            <ListView.View><GridView AllowsColumnReorder="False"><GridViewColumn Header="{loc:Tr Text.253D1510CAF5}" Width="150"><GridViewColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Icon}" Foreground="#68BEBD" Width="17"/><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" Width="118"/></StackPanel></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn><GridViewColumn Header="{loc:Tr Text.E999B6B9631A}" Width="80" DisplayMemberBinding="{Binding SizeText}"/><GridViewColumn Header="{loc:Tr Text.4F2B88BA7005}" Width="50" DisplayMemberBinding="{Binding PercentText}"/></GridView></ListView.View>
          </ListView>
        </DockPanel>
      </Border>
    </Grid>

    <DockPanel Grid.Row="4" Margin="11,0,9,0" LastChildFill="True">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="{loc:Tr Text.C9270BA5323A}" Click="CopyPathClicked" Padding="7,2" FontSize="10" Margin="8,0,5,0" ToolTip="{loc:Tr Help.CopySelection}"/><Button Content="{loc:Tr Text.4CB22594D135}" Click="OpenExplorerClicked" Padding="7,2" FontSize="10" ToolTip="{loc:Tr Help.RevealSelection}"/></StackPanel>
      <TextBlock x:Name="HoverText" Text="{loc:Tr Text.C4811CF617BC}" Foreground="#7D96AA" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
    </DockPanel>
    <Border Grid.Row="5" Background="#101D28" BorderBrush="#293744" BorderThickness="0,1,0,0" Padding="10,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="{loc:Tr Text.DF81553CD468}" Foreground="#8EA8BA" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><ProgressBar x:Name="ScanProgress" Grid.Column="1" Height="3" Margin="12,0" Foreground="#5AD4B7" Background="#253748" Visibility="Collapsed"/><Button x:Name="CancelButton" Grid.Column="2" Content="{loc:Tr Text.BE876433993A}" Click="CancelClicked" Padding="9,2" FontSize="10" Visibility="Collapsed" ToolTip="{loc:Tr Help.CancelScan}"/></Grid>
    </Border>
  </Grid>
</Window>
