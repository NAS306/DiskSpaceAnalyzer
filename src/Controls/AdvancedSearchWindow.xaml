<Window x:Class="DiskSpaceAnalyzer.Controls.AdvancedSearchWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:DiskSpaceAnalyzer.Controls" xmlns:controls="clr-namespace:DiskSpaceAnalyzer.Controls"
        Title="{loc:Tr Text.FD5B83F7DA1D}" Width="600" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#111B24" Foreground="#E5ECF4" FontFamily="Segoe UI, Malgun Gothic" FontSize="12">
  <Window.Resources>
    <Style TargetType="ComboBox" BasedOn="{StaticResource HelpBehaviour}"><Setter Property="Foreground" Value="#10202E"/><Setter Property="Background" Value="#EDF2F5"/><Setter Property="Padding" Value="5,3"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="ItemTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" Foreground="#10202E"/></DataTemplate></Setter.Value></Setter><Style.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#10202E"/></Style></Style.Resources></Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,12,0"/></Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16,12">
      <TextBlock Text="{loc:Tr Text.FD5B83F7DA1D}" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Text="{loc:Tr Text.EB9A5C6E9979}" Foreground="#9BB0C1" Margin="0,4,0,14"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{loc:Tr Text.B6F4503D6EDD}" Style="{StaticResource FieldLabel}"/>
        <StackPanel Grid.Column="1"><ComboBox x:Name="ExtensionsBox" IsEditable="True" SelectionChanged="ConditionChanged" TextBoxBase.TextChanged="ConditionChanged" ToolTip="{loc:Tr Help.Extensions}"/><TextBlock Text="{loc:Tr Text.3CC387D1DAC5}" TextWrapping="Wrap" Foreground="#8CA2B6" FontSize="11" Margin="0,3,0,0"/></StackPanel>
        <TextBlock Grid.Row="1" Text="{loc:Tr Text.162DE9C569FC}" Style="{StaticResource FieldLabel}" Margin="0,12,12,0"/>
        <Grid Grid.Row="1" Grid.Column="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="135"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><ComboBox x:Name="ComparisonBox" SelectionChanged="ConditionChanged" ToolTip="{loc:Tr Help.SizeComparison}"/><TextBox x:Name="SizeBox" Grid.Column="1" Margin="6,0" TextChanged="ConditionChanged" VerticalContentAlignment="Center" ToolTip="{loc:Tr Help.SizeValue}"/><ComboBox x:Name="UnitBox" Grid.Column="2" SelectionChanged="ConditionChanged" ToolTip="{loc:Tr Help.SizeUnit}"/></Grid>
        <TextBlock Grid.Row="2" Text="{loc:Tr Text.675B0129125A}" Style="{StaticResource FieldLabel}" Margin="0,12,12,0"/>
        <ComboBox x:Name="ScopeBox" Grid.Row="2" Grid.Column="1" Margin="0,12,0,0" SelectionChanged="ConditionChanged" ToolTip="{loc:Tr Help.SearchScope}"/>
        <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,6,0,0"><ComboBox x:Name="DriveBox" SelectionChanged="ConditionChanged" ToolTip="{loc:Tr Help.SearchDrive}"/><Grid x:Name="FolderPanel"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="FolderBox" TextChanged="ConditionChanged" VerticalContentAlignment="Center" ToolTip="{loc:Tr Help.SearchFolder}"/><Button Grid.Column="1" Content="{loc:Tr Text.AB437C2C5679}" Click="BrowseClicked" Margin="6,0,0,0" ToolTip="{loc:Tr Help.BrowseSearchFolder}"/></Grid></StackPanel>
        <CheckBox x:Name="ExcludeWindowsBox" Grid.Row="4" Grid.ColumnSpan="2" Content="{loc:Tr Text.B715069E04DB}" Foreground="#E5ECF4" Margin="0,16,0,0" Checked="ConditionChanged" Unchecked="ConditionChanged" ToolTip="{loc:Tr Help.ExcludeWindows}"/>
      </Grid>
      <TextBlock Text="{loc:Tr Text.051E29FBE0E4}" Foreground="#8CA2B6" FontSize="11" Margin="0,4,0,12"/>
      <TextBlock Text="{loc:Tr Text.6FBF865229FA}" FontWeight="SemiBold" Margin="0,0,0,5"/>
      <TextBox x:Name="QueryPreview" IsReadOnly="True" TextWrapping="Wrap" MinHeight="48" MaxHeight="85" VerticalScrollBarVisibility="Auto" Padding="7,5" ToolTip="{loc:Tr Help.QueryPreview}"/>
      <TextBlock x:Name="ExclusionNote" Foreground="#72D5B8" FontSize="11" Margin="0,4,0,0"/>
      <TextBlock x:Name="ErrorText" Foreground="#F4BB7E" TextWrapping="Wrap" MinHeight="18" Margin="0,4,0,8"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{loc:Tr Text.BE876433993A}" IsCancel="True" MinWidth="65" ToolTip="{loc:Tr Help.CancelSearch}"/><Button x:Name="SearchButton" Content="{loc:Tr Text.27ED1E7258D2}" IsDefault="True" Click="SearchClicked" MinWidth="125" Margin="6,0,0,0" ToolTip="{loc:Tr Help.ApplySearch}"/></StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
